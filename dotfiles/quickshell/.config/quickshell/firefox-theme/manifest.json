{
  "manifest_version": 3,
  "name": "Quickshell Theme Sync",
  "version": "1.0.0",
  "description": "Applies the desktop (Quickshell) palette to Firefox via the supported theme API, including the new tab page.",
  "browser_specific_settings": {
    "gecko": {
      "id": "quickshell-theme@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["theme"],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}

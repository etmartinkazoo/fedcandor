/* Generated by fedcandor-theme ({{ name }}) -- do not edit by hand.
 *
 * Version-robust strategy: override ONLY Firefox's own design-token custom
 * properties. These are the variables Firefox's internal stylesheets consume,
 * so they survive the DOM id/class churn that regularly breaks selector-based
 * userChrome hacks (e.g. the Firefox 133 / 140 tab changes).
 *
 * Anything selector-based (#navigator-toolbox, .tab-background, #urlbar-background,
 * ...) has intentionally been dropped: those are the parts that rot.
 *
 * The supported WebExtension "fedcandor Theme Sync" mirrors this same palette
 * via the theme API (chrome + menus + sidebar + new tab page).
 */

:root {
    /* hand-off tokens, for any custom rules you add yourself */
    --qs-bg-panel: {{ background }};
    --qs-bg-item: {{ dark_background }};
    --qs-bg-selected: {{ mix background accent 28% }};
    --qs-border: {{ mix background accent 55% }};
    --qs-border-subtle: {{ mix background foreground 14% }};
    --qs-text-primary: {{ bright_foreground }};
    --qs-text-secondary: {{ mix bright_foreground background 30% }};
    --qs-radius: 0px;

    /* chrome surfaces */
    --toolbar-bgcolor: {{ background }} !important;
    --toolbar-color: {{ bright_foreground }} !important;
    --lwt-accent-color: {{ dark_background }} !important;
    --lwt-text-color: {{ bright_foreground }} !important;

    /* URL bar / search */
    --toolbar-field-color: {{ bright_foreground }} !important;
    --toolbar-field-background-color: {{ dark_background }} !important;
    --toolbar-field-border-color: {{ mix background accent 55% }} !important;
    --toolbar-field-focus-color: {{ bright_foreground }} !important;
    --toolbar-field-focus-background-color: {{ dark_background }} !important;
    --toolbar-field-focus-border-color: {{ mix background accent 28% }} !important;

    /* tabs */
    --tab-selected-bgcolor: {{ mix background accent 28% }} !important;
    --tab-selected-textcolor: {{ bright_foreground }} !important;
    --lwt-selected-tab-background-color: {{ mix background accent 28% }} !important;
    --tab-border-radius: 0px !important;

    /* content area behind the tabs */
    --tabpanel-background-color: {{ dark_background }} !important;

    /* menus / panels */
    --arrowpanel-background: {{ background }} !important;
    --arrowpanel-color: {{ bright_foreground }} !important;
    --arrowpanel-border-color: {{ mix background accent 55% }} !important;

    /* sidebar */
    --sidebar-background-color: {{ background }} !important;
    --sidebar-text-color: {{ bright_foreground }} !important;
    --sidebar-border-color: {{ mix background accent 55% }} !important;

    /* focus + corners */
    --focus-outline-color: {{ mix background accent 28% }} !important;
    --border-radius-small: 0px !important;
    --border-radius-medium: 0px !important;
    --border-radius-large: 0px !important;
}
